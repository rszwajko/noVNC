{
  "name": "@rszwajko/standalone",
  "version": "1.6.0",
  "description": "Single-page standalone noVNC",
  "type": "module",
  "files": [
    "dist",
    "AUTHORS",
    "VERSION",
    "docs/API.md",
    "docs/LIBRARY.md",
    "docs/LICENSE*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/standalone.js",
  "exports": {
    ".": "./dist/standalone.js"
  },
  "scripts": {
    "lint": "eslint app core po/po2js po/xgettext-html tests utils",
    "test": "karma start karma.conf.cjs",
    "clean": "rimraf ./dist ./standalone",
    "build:standalone": "webpack --config webpack.standalone.config.js",
    "build:dist": "webpack --config webpack.dist.config.js",
    "build": "npm run build:standalone && npm run build:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rszwajko/noVNC.git"
  },
  "author": "Joel Martin <github@martintribe.org> (https://github.com/kanaka)",
  "contributors": [
    "Samuel Mannehed <samuel@cendio.se> (https://github.com/samhed)",
    "Pierre Ossman <ossman@cendio.se> (https://github.com/CendioOssman)"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/rszwajko/noVNC",
  "devDependencies": {
    "@babel/core": "latest",
    "@babel/preset-env": "latest",
    "@chiragrupani/karma-chromium-edge-launcher": "latest",
    "babel-plugin-import-redirect": "latest",
    "browserify": "latest",
    "chai": "latest",
    "commander": "latest",
    "css-loader": "^7.1.2",
    "eslint": "latest",
    "fs-extra": "latest",
    "globals": "latest",
    "html-bundler-webpack-plugin": "^4.22.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.5",
    "jsdom": "latest",
    "karma": "latest",
    "karma-chrome-launcher": "latest",
    "karma-firefox-launcher": "latest",
    "karma-ie-launcher": "latest",
    "karma-mocha": "latest",
    "karma-mocha-reporter": "latest",
    "karma-safari-launcher": "latest",
    "karma-script-launcher": "latest",
    "mocha": "latest",
    "pofile": "latest",
    "rimraf": "6.1.2",
    "sinon": "latest",
    "sinon-chai": "latest",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "vnc",
    "rfb",
    "novnc",
    "websockify"
  ]
}
